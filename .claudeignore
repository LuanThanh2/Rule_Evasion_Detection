venv/
.venv/
env/

# Trained model outputs — binary ZIP files, không đọc được
models/

# Raw datasets — quá lớn, không phải code
data/
datasets/

# Git internals
.git/

# IDE / OS
.idea/
.vscode/
*.DS_Store
Thumbs.db

# Logs
*.log
